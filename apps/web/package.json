{
  "name": "@remitia/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RemitIA — shell de demo mobile-first (SvelteKit + adapter-static, servido por FastAPI)",
  "scripts": {
    "dev": "vite dev",
    "dev:api": "vite dev --mode development-api",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "prepare": "svelte-kit sync || echo ''"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0"
  }
}
